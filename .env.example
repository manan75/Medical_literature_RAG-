# ---- LLM (generation) ----
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.0-flash

# ---- NCBI E-utilities (PubMed / PMC) ----
# Optional but recommended: raises rate limit from 3 to 10 requests/sec.
# Get one free at https://account.ncbi.nlm.nih.gov/settings/
NCBI_API_KEY=
# NCBI asks that automated clients identify themselves.
NCBI_EMAIL=you@example.com
NCBI_TOOL=medical-literature-rag

# ---- Models ----
EMBEDDING_MODEL=NeuML/pubmedbert-base-embeddings
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
